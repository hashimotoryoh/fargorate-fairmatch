NUXT_PUBLIC_SITE_URL=http://localhost:3000

# セッションクッキーの署名・暗号化に使う秘密鍵。32文字以上が必要。
# 開発サーバーの起動時に未設定であれば nuxt-auth-utils が .env に自動生成する。
NUXT_SESSION_PASSWORD=

# reCAPTCHA v3 のキー。https://www.google.com/recaptcha/admin でv3のサイトを登録して取得する。
# 開発環境（npm run dev）ではreCAPTCHAを素通しにするため、未設定のままでよい。
# 動作を確かめる場合は、ドメインに localhost を加えたキーを設定し本番ビルドで起動する。
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
NUXT_RECAPTCHA_SECRET_KEY=
