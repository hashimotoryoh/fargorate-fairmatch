# セッションクッキーの署名・暗号化に使う秘密鍵。32文字以上が必要。
# 開発サーバーの起動時に未設定であれば nuxt-auth-utils が .env に自動生成する。
NUXT_SESSION_PASSWORD=

# 公開URLのオリジン。OGPやcanonicalの絶対URLの組み立てに使う。
# 未設定の場合はそれらのメタタグを出力しない。
NUXT_PUBLIC_SITE_URL=

# reCAPTCHA v3 のキー。https://www.google.com/recaptcha/admin でv3のサイトを
# 登録して取得する。ローカル開発では常に成功するGoogle公式のテスト用キーで
# 良い（サイトキー: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI、
# シークレットキー: 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe）。
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
NUXT_RECAPTCHA_SECRET_KEY=
